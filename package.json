{
  "name": "simultaneous-apocalypse-simulator",
  "version": "0.2.0",
  "private": true,
  "description": "三世界并行文字末日模拟器 H5 原型",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint src tests scripts eslint.config.mjs",
    "format": "prettier --write src tests scripts eslint.config.mjs",
    "format:check": "prettier --check \"scripts/**/*.mjs\" \"eslint.config.mjs\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "balance": "node scripts/balance-report.mjs --seeds=100",
    "balance:check": "node scripts/balance-report.mjs --seeds=100 --assert",
    "verify": "npm run lint && npm run format:check && npm test && npm run build && npm run balance:check"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "seedrandom": "^3.0.5"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  }
}
